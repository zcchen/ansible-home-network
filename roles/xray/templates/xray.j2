#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

NAME=xray
PROG={{ _xray__binary_path }}
APPENDIX=json
CONFS_WILDCARD=/etc/xray/*.${APPENDIX}
XRAY_LOCATION_ASSET="{{ xray__location_asset }}"

start_service() {

        local conffiles
        conffiles=$(ls -1 $CONFS_WILDCARD)
        [ -n "$conffiles" ] && {
                for i in $conffiles; do
                        procd_open_instance "$NAME-$(basename -s .${APPENDIX} $i)"
                        if [ -n "$XRAY_LOCATION_ASSET" ]; then
                                procd_set_param env XRAY_LOCATION_ASSET=$XRAY_LOCATION_ASSET
                        fi
                        procd_set_param command "$PROG"
                        procd_append_param command run
                        procd_append_param command -config "$i"
                        procd_set_param limits core="unlimited"
                        procd_set_param limits nofile="1000000 1000000"
                        procd_set_param stdout 1
                        procd_set_param stderr 1
                        procd_set_param respawn
                        procd_close_instance
                done
        }
}

reload_service() {
        stop
        start
}

service_triggers() {
        [ -n "$conffiles" ] && {
                for i in $conffiles; do
                        procd_add_reload_trigger "$NAME-$(basename -s .${APPENDIX} $i)"
                done
        }
}
