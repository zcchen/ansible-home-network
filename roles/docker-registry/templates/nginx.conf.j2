worker_processes auto;

events {
    worker_connections 1024;
}

http {
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
{% if _registry__domain.base %}
        server_name {{ _registry__domain.base }};
{%   for key, value in _registry__domain.ports.items() %}
{%     if value.is_default is defined and value.is_default %}
        return 302 $scheme://{{ value.subdomain }}.{{ _registry__domain.base }}$request_uri;
{%     endif %}
{%   endfor %}
{#   TODO: raise error if no value set it is default #}
{% else %}
        server_name _;
        return 444;
{% endif %}
    }
{% for key, value in _registry__domain.ports.items() %}
    server {
        listen 80;
        listen [::]:80;
{%   if _registry__domain.base %}
        server_name {{ value.subdomain }}.{{ _registry__domain.base }};
{%   else %}
        server_name {{ value.subdomain }}.*;
{%   endif %}

        location /browser/ {
            rewrite /browser/(.*) /$1 break;
            proxy_buffering off;
            proxy_ignore_headers "X-Accel-Buffering";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Server $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass http://registry-ui_{{ key }};
        }
        location / {
            return 302 /browser/;
        }
        location /v2/ {
            # Do not allow connections from docker 1.5 and earlier
            # docker pre-1.6.0 did not properly set the user agent on ping, catch "Go *" user agents
            if ($http_user_agent ~ "^(docker\/1\.(3|4|5(?!\.[0-9]-dev))|Go ).*$" ) {
              return 404;
            }
            add_header 'Docker-Distribution-Api-Version' 'registry/2.0' always;

            # Do NOT use base auth, because of the bug from docker.
            #   https://github.com/moby/moby/issues/30880

            # disable any limits to avoid HTTP 413 for large image uploads
            client_max_body_size 0;
            # required to avoid HTTP 411: see Issue #1486 (https://github.com/moby/moby/issues/1486)
            chunked_transfer_encoding on;
            # required for strict SNI checking: see Issue #70 (https://github.com/Joxit/docker-registry-ui/issues/70)
            #proxy_ssl_server_name on;

            proxy_buffering off;
            proxy_ignore_headers "X-Accel-Buffering";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Server $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass http://registry-offical_{{ key }}:5000;
        }
    }
{% endfor %}
}
