#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

NAME=frpc
PROG={{ frp__client_cmd }}
APPENDIX=toml
CONFS_WILDCARD=/etc/frpc/*.${APPENDIX}

start_service() {
        local conffiles
        #local count
        conffiles=$(ls -1 $CONFS_WILDCARD)
        [ -n "$conffiles" ] && {
                for i in $conffiles
                do
                        procd_open_instance "$NAME@$(basename -s .${APPENDIX} $i)"
                        procd_set_param command "$PROG"
{% if frp__client_argv_foreground %}
                        procd_append_param command {{ frp__client_argv_foreground }}
{% endif %}
                        procd_append_param command -c "$i"
                        procd_set_param limits core="unlimited"
                        procd_set_param limits nofile="1000000 1000000"
                        procd_set_param stdout 1
                        procd_set_param stderr 1
                        procd_set_param respawn
                        procd_close_instance
                done
        }
}

reload_service() {
        stop
        start
}

service_triggers() {
        # local count
        [ -n "$conffiles" ] && {
                for i in $conffiles
                do
                        procd_add_reload_trigger "$NAME@$(basename -s .${APPENDIX} $i)"
                done
        }
}
